# ========================================================
# PAVILION REALTY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in real production secrets
# ========================================================

# Application Environment
APP_ENV=development
DEBUG=true
DOMAIN_NAME=pavilionrealty.com

# Cryptographic Keys (Generate with: openssl rand -hex 32)
SECRET_KEY=super-secret-key-change-in-production-pavilion-2025-token
JWT_SECRET_KEY=jwt-secret-key-change-in-production-pavilion-2025-auth
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# Database (MySQL 8.0)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=realestate_db
MYSQL_USER=realestate_user
MYSQL_PASSWORD=realestate_secret
MYSQL_ROOT_PASSWORD=root_super_secure_2025

# Redis Caching & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# Storage Strategy ("local" or "s3")
STORAGE_TYPE=local
MEDIA_DIR=./media/uploads

# AWS S3 (When STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=pavilion-realty-media
AWS_ENDPOINT_URL=

# Public Frontend & Admin URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_RESET_PER_HOUR=3
RATE_LIMIT_ENQUIRY_PER_MIN=5
RATE_LIMIT_GENERAL_PER_MIN=120

# SMTP Email Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@pavilionrealty.com
SMTP_FROM_NAME=Pavilion Realty
ADMIN_NOTIFICATION_EMAIL=admin@pavilionrealty.com

# Initial Seed Super Admin Credentials
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Admin
